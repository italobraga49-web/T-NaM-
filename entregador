<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>TáNaMão — Entregador</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{--o:#f4512c;--o2:#ff7a18;--ink:#171a21;--muted:#667085;--line:#e5e7eb;--bg:#f6f7f9;--card:#fff;--green:#16803c;--red:#b42318;--shadow:0 12px 34px #1118270d}
*{box-sizing:border-box}html,body{margin:0;min-height:100%}body{font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--ink);font-size:14px}button,input,select{font:inherit}.hidden{display:none!important}
.utility{background:#181b20;color:#fff;font-size:12px}.utility-in{max-width:1320px;margin:auto;padding:8px 20px;display:flex;justify-content:space-between;gap:16px}
.top{position:sticky;top:0;z-index:30;background:#fff;border-bottom:1px solid var(--line)}.topbar{max-width:1320px;margin:auto;padding:9px 20px;display:flex;align-items:center;justify-content:space-between;gap:18px}.logo{width:150px;height:54px;object-fit:contain}
.btn{border:1px solid #d7dbe0;background:#fff;border-radius:9px;padding:10px 13px;cursor:pointer;font-weight:700}.btn.primary{background:var(--o);border-color:var(--o);color:#fff}.btn.green{background:var(--green);border-color:var(--green);color:#fff}.btn.danger{color:var(--red);border-color:#fda29b}.btn:disabled{opacity:.55;cursor:not-allowed}
.layout{display:grid;grid-template-columns:230px 1fr;min-height:calc(100vh - 98px)}aside.side{background:#fff;border-right:1px solid var(--line);padding:18px 12px}.nav{width:100%;border:0;background:transparent;text-align:left;padding:13px 14px;border-radius:10px;margin:3px 0;cursor:pointer}.nav.active,.nav:hover{background:#fff1eb;color:#d84a12;font-weight:800}
main{padding:22px;max-width:1200px;width:100%;margin:auto}.section{display:none}.section.active{display:block}.muted{color:var(--muted)}h1{margin:0 0 5px;font-size:25px}
.card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px;margin:14px 0;box-shadow:var(--shadow)}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.stat b{display:block;font-size:23px;margin-top:7px}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.full{grid-column:1/-1}label{display:block;font-size:12px;font-weight:800;margin:4px 0 5px}input,select{width:100%;padding:11px;border:1px solid #d5d9de;border-radius:8px;background:#fff}
.badge{display:inline-block;padding:5px 8px;border-radius:999px;background:#f2f4f7;font-size:11px;font-weight:800}.badge.green{background:#ecfdf3;color:#067647}.badge.orange{background:#fff1eb;color:#d84a12}
.delivery{border:1px solid var(--line);border-radius:12px;padding:15px;margin:10px 0;background:#fff}.delivery-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.delivery-price{font-size:20px;font-weight:900;color:var(--green)}.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:12px 0}.info{background:#fafafa;border:1px solid var(--line);border-radius:9px;padding:10px;font-size:12px;line-height:1.5}.info b{display:block;margin-bottom:4px}
.flow{display:flex;gap:6px;flex-wrap:wrap;margin:12px 0}.step{padding:6px 8px;border-radius:999px;background:#f2f4f7;font-size:11px}.step.on{background:#fff1eb;color:#d84a12;font-weight:800}.step.done{background:#ecfdf3;color:#067647;font-weight:800}
.actions{display:flex;gap:8px;flex-wrap:wrap}.wallet{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.wallet-box{border:1px solid var(--line);border-radius:12px;padding:15px;background:#fafafa}.wallet-box b{display:block;font-size:22px;margin-top:5px}
.list-row{display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid var(--line)}.list-row:last-child{border-bottom:0}.msg{margin-top:10px;padding:10px;border-radius:8px;background:#f3f4f6;font-size:12px}.msg.ok{background:#ecfdf3;color:#067647}.msg.err{background:#fef3f2;color:#b42318}
.auth{max-width:500px;margin:42px auto;padding:0 12px}.auth .logo{display:block;margin:auto;width:180px;height:70px}.tabs{display:flex;gap:8px;margin:14px 0}.tabs .btn{flex:1}
.empty{border:1px dashed #d5d9df;border-radius:12px;padding:25px;text-align:center;color:var(--muted);background:#fff}
@media(max-width:800px){.utility{display:none}.topbar{padding:7px 10px}.logo{width:105px;height:42px}.layout{grid-template-columns:1fr}.side{display:flex!important;overflow:auto;padding:7px!important;position:sticky;top:57px;z-index:20}.nav{min-width:max-content;padding:10px}.stats,.wallet,.grid,.info-grid{grid-template-columns:1fr}main{padding:12px}.delivery-head{flex-direction:column}.topbar .btn{padding:8px 9px;font-size:11px}}
</style>
</head>
<body>

<div id="authView" class="auth">
  <div class="card">
    <img src="1001111814.png" class="logo" alt="TáNaMão">
    <div style="text-align:center"><h2>Central do Entregador</h2><p class="muted">Faça login ou crie sua conta para realizar entregas.</p></div>
    <div class="tabs"><button class="btn primary" onclick="showAuth('login')">Entrar</button><button class="btn" onclick="showAuth('cadastro')">Cadastrar</button></div>
    <div id="loginBox">
      <label>E-mail</label><input id="loginEmail" type="email">
      <label>Senha</label><input id="loginSenha" type="password">
      <button class="btn primary" style="width:100%;margin-top:14px" onclick="login()">Entrar</button>
    </div>
    <div id="cadBox" class="hidden">
      <div class="grid">
        <div><label>Nome completo</label><input id="cadNome"></div>
        <div><label>Telefone</label><input id="cadTelefone"></div>
        <div class="full"><label>E-mail</label><input id="cadEmail" type="email"></div>
        <div class="full"><label>Senha</label><input id="cadSenha" type="password" minlength="6"></div>
      </div>
      <button class="btn primary" style="width:100%;margin-top:14px" onclick="cadastrar()">Criar conta de entregador</button>
    </div>
    <div id="authMsg"></div>
  </div>
</div>

<div id="app" class="hidden">
  <div class="utility"><div class="utility-in"><span>TáNaMão Entregas • pedidos locais em um só lugar</span><span>Entregue com segurança e acompanhe seus ganhos</span></div></div>
  <header class="top"><div class="topbar"><img src="1001111814.png" class="logo" alt="TáNaMão"><div><span id="driverTop" class="badge">Entregador</span> <button class="btn" onclick="logout()">Sair</button></div></div></header>
  <div class="layout">
    <aside class="side">
      <button class="nav active" onclick="go('inicio',this)">🏠 Visão geral</button>
      <button class="nav" onclick="go('disponiveis',this)">🛵 Entregas</button>
      <button class="nav" onclick="go('atual',this)">📦 Entrega atual</button>
      <button class="nav" onclick="go('carteira',this)">💰 Carteira</button>
      <button class="nav" onclick="go('historico',this)">📋 Histórico</button>
      <button class="nav" onclick="go('perfil',this)">👤 Perfil</button>
    </aside>
    <main>
      <section id="inicio" class="section active">
        <h1>Central do Entregador</h1><p class="muted">Acompanhe entregas, saldo e recebimentos.</p>
        <div class="stats">
          <div class="card stat">Disponíveis<b id="nDisponiveis">0</b></div>
          <div class="card stat">Em andamento<b id="nAndamento">0</b></div>
          <div class="card stat">Concluídas<b id="nConcluidas">0</b></div>
          <div class="card stat">Saldo<b id="nSaldo">R$ 0,00</b></div>
        </div>
        <div class="card"><h3>Status da conta</h3><p id="statusConta" class="muted">Carregando...</p></div>
      </section>

      <section id="disponiveis" class="section">
        <h1>Entregas disponíveis</h1><p class="muted">Pedidos prontos para um entregador aceitar.</p>
        <button class="btn" onclick="carregarTudo()">Atualizar</button>
        <div id="listaDisponiveis"></div>
      </section>

      <section id="atual" class="section">
        <h1>Minha entrega atual</h1><p class="muted">Avance as etapas somente quando elas realmente acontecerem.</p>
        <div id="entregaAtual"></div>
      </section>

      <section id="carteira" class="section">
        <h1>Carteira</h1>
        <div class="wallet">
          <div class="wallet-box">Saldo disponível<b id="saldoDisponivel">R$ 0,00</b></div>
          <div class="wallet-box">A receber<b id="saldoPendente">R$ 0,00</b></div>
          <div class="wallet-box">Total recebido<b id="totalRecebido">R$ 0,00</b></div>
        </div>
        <div class="card">
          <h3>Minha chave Pix</h3>
          <div class="grid">
            <div><label>Tipo da chave</label><select id="pixTipo"><option value="">Selecione</option><option value="cpf">CPF</option><option value="cnpj">CNPJ</option><option value="email">E-mail</option><option value="telefone">Telefone</option><option value="aleatoria">Chave aleatória</option></select></div>
            <div><label>Chave Pix</label><input id="pixChave" placeholder="Digite sua chave"></div>
          </div>
          <button class="btn primary" style="margin-top:12px" onclick="salvarPix()">Salvar chave Pix</button><div id="pixMsg"></div>
        </div>
        <div class="card">
          <h3>Solicitar saque</h3><p class="muted">O valor só é descontado quando a solicitação é registrada pelo servidor.</p>
          <label>Valor do saque (R$)</label><input id="saqueValor" type="number" min="0.01" step="0.01" placeholder="0,00">
          <button class="btn green" style="margin-top:12px" onclick="solicitarSaque()">Solicitar saque via Pix</button><div id="saqueMsg"></div>
        </div>
      </section>

      <section id="historico" class="section">
        <h1>Histórico</h1><div class="card"><h3>Movimentações</h3><div id="listaMovimentos"></div></div>
        <div class="card"><h3>Saques</h3><div id="listaSaques"></div></div>
      </section>

      <section id="perfil" class="section">
        <h1>Perfil</h1>
        <div class="card"><div class="grid"><div><label>Nome</label><input id="perfilNome"></div><div><label>Telefone</label><input id="perfilTelefone"></div><div><label>E-mail</label><input id="perfilEmail" disabled></div><div><label>Situação</label><input id="perfilStatus" disabled></div></div><button class="btn primary" style="margin-top:12px" onclick="salvarPerfil()">Salvar perfil</button><div id="perfilMsg"></div></div>
      </section>
    </main>
  </div>
</div>

<script>
const SUPABASE_URL="https://sfzfoavesiintdyoxkca.supabase.co";
const SUPABASE_KEY="sb_publishable_wM4A1etSRHTcUpE4qUXb-A_suN-jnep";
const sb=window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY);
const $=id=>document.getElementById(id);
const money=v=>Number(v||0).toLocaleString("pt-BR",{style:"currency",currency:"BRL"});
const esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
let user=null,driver=null,wallet=null,currentOrder=null;

function setMsg(id,text,type=""){const e=$(id);e.innerHTML=text?`<div class="msg ${type}">${esc(text)}</div>`:""}
function showAuth(t){$("loginBox").classList.toggle("hidden",t!=="login");$("cadBox").classList.toggle("hidden",t!=="cadastro")}
function go(id,b){document.querySelectorAll(".section").forEach(x=>x.classList.remove("active"));$(id).classList.add("active");document.querySelectorAll(".nav").forEach(x=>x.classList.remove("active"));if(b)b.classList.add("active");if(["disponiveis","atual","carteira","historico"].includes(id))carregarTudo()}
function endereco(v){if(!v)return "Endereço não informado";if(typeof v==="string"){try{v=JSON.parse(v)}catch(e){return v}}return [v.rua||v.endereco,v.numero,v.complemento,v.bairro,v.cidade,v.estado||v.uf,v.cep].filter(Boolean).join(", ")}
function storeAddress(s){return [s?.endereco||s?.rua,s?.numero,s?.complemento,s?.bairro,s?.cidade,s?.estado||s?.uf,s?.cep].filter(Boolean).join(", ")||"Endereço da loja não informado"}
function labelStatus(s){return ({aguardando_entregador:"Aguardando entregador",aceita:"Aceita",indo_buscar:"Indo buscar",na_loja:"Na loja",coletado:"Pedido coletado",em_rota:"Em rota",entregue:"Entregue",cancelada:"Cancelada"})[s]||s||"—"}

async function login(){
 setMsg("authMsg","Entrando...");
 const {data,error}=await sb.auth.signInWithPassword({email:$("loginEmail").value.trim(),password:$("loginSenha").value});
 if(error)return setMsg("authMsg","Erro: "+error.message,"err");
 await iniciar(data.user);
}
async function cadastrar(){
 const nome=$("cadNome").value.trim(),telefone=$("cadTelefone").value.trim(),email=$("cadEmail").value.trim(),password=$("cadSenha").value;
 if(!nome||!email||password.length<6)return setMsg("authMsg","Preencha nome, e-mail e uma senha com pelo menos 6 caracteres.","err");
 setMsg("authMsg","Criando conta...");
 const {data,error}=await sb.auth.signUp({email,password,options:{data:{nome,telefone,tipo:"entregador"}}});
 if(error)return setMsg("authMsg","Erro: "+error.message,"err");
 if(!data.session)return setMsg("authMsg","Conta criada. Confirme seu e-mail e depois faça login.","ok");
 await iniciar(data.user);
}
async function logout(){await sb.auth.signOut();location.reload()}

async function iniciar(u){
 user=u;
 const {data,error}=await sb.rpc("ensure_driver_profile",{p_nome:u.user_metadata?.nome||u.email,p_telefone:u.user_metadata?.telefone||null});
 if(error){setMsg("authMsg","Conta autenticada, mas falta instalar o SQL complementar do entregador: "+error.message,"err");return}
 driver=data;
 $("authView").classList.add("hidden");$("app").classList.remove("hidden");
 $("driverTop").textContent=driver?.nome||"Entregador";
 preencherPerfil();
 await carregarTudo();
}
function preencherPerfil(){
 $("perfilNome").value=driver?.nome||"";
 $("perfilTelefone").value=driver?.telefone||"";
 $("perfilEmail").value=user?.email||"";
 $("perfilStatus").value=driver?.ativo?"Ativo":"Inativo";
 $("pixTipo").value=driver?.pix_key_type||"";
 $("pixChave").value=driver?.pix_key||"";
 $("statusConta").textContent=driver?.ativo?"Sua conta está ativa para receber entregas.":"Sua conta está inativa. Entre em contato com a administração.";
}

async function salvarPerfil(){
 const payload={nome:$("perfilNome").value.trim(),telefone:$("perfilTelefone").value.trim()||null};
 const {data,error}=await sb.rpc("update_driver_profile",{p_nome:payload.nome,p_telefone:payload.telefone});
 if(error)return setMsg("perfilMsg",error.message,"err");
 driver={...driver,...data};$("driverTop").textContent=driver.nome||"Entregador";setMsg("perfilMsg","Perfil atualizado.","ok")
}
async function salvarPix(){
 const tipo=$("pixTipo").value,chave=$("pixChave").value.trim();
 if(!tipo||!chave)return setMsg("pixMsg","Informe o tipo e a chave Pix.","err");
 const {data,error}=await sb.rpc("save_driver_pix",{p_pix_key_type:tipo,p_pix_key:chave});
 if(error)return setMsg("pixMsg",error.message,"err");
 driver={...driver,...data};setMsg("pixMsg","Chave Pix salva com segurança.","ok")
}
async function solicitarSaque(){
 const valor=Number($("saqueValor").value);
 if(!Number.isFinite(valor)||valor<=0)return setMsg("saqueMsg","Informe um valor válido.","err");
 if(!driver?.pix_key)return setMsg("saqueMsg","Cadastre sua chave Pix antes de solicitar o saque.","err");
 $("saqueValor").disabled=true;setMsg("saqueMsg","Registrando solicitação...");
 const {data,error}=await sb.rpc("request_driver_withdrawal",{p_amount:valor});
 $("saqueValor").disabled=false;
 if(error)return setMsg("saqueMsg",error.message,"err");
 $("saqueValor").value="";setMsg("saqueMsg","Saque solicitado. Status: "+(data?.status||"solicitado")+".","ok");await carregarTudo();
}

async function carregarTudo(){
 if(!driver)return;
 await Promise.all([carregarCarteira(),carregarDisponiveis(),carregarAtual(),carregarHistorico()]);
}
async function carregarCarteira(){
 const {data,error}=await sb.from("driver_wallets").select("*").eq("driver_id",driver.id).maybeSingle();
 if(!error&&data)wallet=data;
 $("saldoDisponivel").textContent=money(wallet?.saldo_disponivel);
 $("saldoPendente").textContent=money(wallet?.saldo_pendente);
 $("totalRecebido").textContent=money(wallet?.total_recebido);
 $("nSaldo").textContent=money(wallet?.saldo_disponivel);
}
async function carregarDisponiveis(){
 const {data,error}=await sb.from("orders").select("id,store_id,total,frete,delivery_fee_driver,endereco_entrega,delivery_status,created_at,stores(nome,endereco,rua,numero,complemento,bairro,cidade,estado,uf,cep)").is("driver_id",null).eq("delivery_status","aguardando_entregador").order("created_at",{ascending:true}).limit(50);
 const a=data||[];$("nDisponiveis").textContent=a.length;
 if(error){$("listaDisponiveis").innerHTML=`<div class="empty">${esc(error.message)}</div>`;return}
 $("listaDisponiveis").innerHTML=a.length?a.map(o=>`<div class="delivery"><div class="delivery-head"><div><b>Pedido #${o.id}</b><div class="muted">${esc(o.stores?.nome||"Loja")}</div></div><div class="delivery-price">${money(o.delivery_fee_driver||o.frete||0)}</div></div><div class="info-grid"><div class="info"><b>Coleta</b>${esc(storeAddress(o.stores))}</div><div class="info"><b>Entrega</b>${esc(endereco(o.endereco_entrega))}</div></div><button class="btn primary" onclick="aceitar(${o.id})">Aceitar entrega</button></div>`).join(""):'<div class="empty">Nenhuma entrega disponível agora.</div>';
}
async function aceitar(id){
 if(currentOrder)return alert("Conclua sua entrega atual antes de aceitar outra.");
 const {data,error}=await sb.rpc("accept_delivery",{p_order_id:id});
 if(error)return alert(error.message);
 await carregarTudo();go("atual",document.querySelectorAll(".nav")[2]);
}
async function carregarAtual(){
 const {data,error}=await sb.from("orders").select("id,store_id,total,frete,delivery_fee_driver,endereco_entrega,delivery_status,driver_accepted_at,created_at,stores(nome,telefone,endereco,rua,numero,complemento,bairro,cidade,estado,uf,cep)").eq("driver_id",driver.id).not("delivery_status","in",'("entregue","cancelada")').order("driver_accepted_at",{ascending:false}).limit(1).maybeSingle();
 currentOrder=!error?data:null;
 $("nAndamento").textContent=currentOrder?1:0;
 if(error){$("entregaAtual").innerHTML=`<div class="empty">${esc(error.message)}</div>`;return}
 if(!currentOrder){$("entregaAtual").innerHTML='<div class="empty">Você não possui entrega em andamento.</div>';return}
 const o=currentOrder,steps=["aceita","indo_buscar","na_loja","coletado","em_rota","entregue"],idx=steps.indexOf(o.delivery_status);
 const flow=steps.map((s,i)=>`<span class="step ${i<idx?"done":i===idx?"on":""}">${esc(labelStatus(s))}</span>`).join("");
 const next={aceita:["indo_buscar","Ir buscar pedido"],indo_buscar:["na_loja","Cheguei à loja"],na_loja:["coletado","Pedido coletado"],coletado:["em_rota","Iniciar entrega"],em_rota:["entregue","Confirmar entrega"]}[o.delivery_status];
 $("entregaAtual").innerHTML=`<div class="delivery"><div class="delivery-head"><div><b style="font-size:18px">Pedido #${o.id}</b><div class="muted">${esc(o.stores?.nome||"Loja")}</div></div><div class="delivery-price">${money(o.delivery_fee_driver||o.frete||0)}</div></div><div class="flow">${flow}</div><div class="info-grid"><div class="info"><b>Retirar em</b>${esc(storeAddress(o.stores))}${o.stores?.telefone?`<br>Telefone: ${esc(o.stores.telefone)}`:""}</div><div class="info"><b>Entregar em</b>${esc(endereco(o.endereco_entrega))}</div></div><div class="actions">${next?`<button class="btn ${next[0]==="entregue"?"green":"primary"}" onclick="avancarStatus('${next[0]}')">${next[1]}</button>`:""}</div></div>`;
}
async function avancarStatus(status){
 if(!currentOrder)return;
 if(status==="entregue"&&!confirm("Confirma que o pedido foi entregue ao cliente?"))return;
 const {data,error}=await sb.rpc("update_delivery_status",{p_order_id:currentOrder.id,p_status:status});
 if(error)return alert(error.message);
 await carregarTudo();
}
async function carregarHistorico(){
 const [{data:mov,error:me},{data:saq,error:se},{count}]=await Promise.all([
  sb.from("driver_wallet_transactions").select("*").eq("driver_id",driver.id).order("created_at",{ascending:false}).limit(50),
  sb.from("driver_withdrawals").select("*").eq("driver_id",driver.id).order("created_at",{ascending:false}).limit(50),
  sb.from("orders").select("id",{count:"exact",head:true}).eq("driver_id",driver.id).eq("delivery_status","entregue")
 ]);
 $("nConcluidas").textContent=count||0;
 $("listaMovimentos").innerHTML=me?`<div class="muted">${esc(me.message)}</div>`:(mov||[]).length?(mov||[]).map(x=>`<div class="list-row"><div><b>${esc(x.descricao||x.tipo)}</b><div class="muted">${new Date(x.created_at).toLocaleString("pt-BR")}</div></div><b>${money(x.valor)}</b></div>`).join(""):'<div class="muted">Nenhuma movimentação.</div>';
 $("listaSaques").innerHTML=se?`<div class="muted">${esc(se.message)}</div>`:(saq||[]).length?(saq||[]).map(x=>`<div class="list-row"><div><b>Saque #${x.id}</b><div class="muted">${new Date(x.created_at).toLocaleString("pt-BR")} · ${esc(x.status)}</div></div><b>${money(x.amount)}</b></div>`).join(""):'<div class="muted">Nenhum saque solicitado.</div>';
}

sb.auth.onAuthStateChange(async(event,session)=>{if(event==="SIGNED_OUT")return;});
(async()=>{const {data:{session}}=await sb.auth.getSession();if(session?.user)await iniciar(session.user)})();
</script>
</body>
</html>
